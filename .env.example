# Image identity. The evidence runbook overrides SOURCE_REVISION with Git HEAD
# and fails unless the resulting OCI revision label is exactly equal to it.
RAG_MVP_IMAGE=rag-mvp:dev
RAG_MVP_APP_VERSION=0.1.0
RAG_MVP_SOURCE_REVISION=unknown

# Loopback is the safe local default. Public or LAN exposure requires an auth layer.
RAG_MVP_BIND_ADDRESS=127.0.0.1
RAG_MVP_HOST_PORT=8000
RAG_MVP_CONTAINER_PORT=8000
# The evidence runbook overrides this with a unique, confirmed-new volume.
# This shared fallback is only for ordinary local development.
RAG_MVP_DATA_VOLUME=rag-mvp-data

# The Compose deployment is intentionally one application container.
RAG_MVP_WORKBENCH_ENABLED=true
RAG_MVP_PROVIDER_BACKEND=openai
RAG_MVP_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_MVP_OPENAI_SEND_DIMENSIONS=true
RAG_MVP_OPENAI_MAX_TOKENS_PARAMETER=max_completion_tokens
RAG_MVP_EMBEDDING_MODEL=text-embedding-3-small
RAG_MVP_EMBEDDING_DIMENSION=1536
RAG_MVP_GENERATION_MODEL=gpt-4.1-mini
RAG_MVP_RERANKING_MODEL=
RAG_MVP_PROVIDER_TIMEOUT_SECONDS=8
RAG_MVP_PROVIDER_RETRY_LIMIT=1

# Workbench retrieval profiles. The OpenAI-compatible profile remains the HTTP
# API/default path; BGE uses an independent corpus and vector index.
RAG_MVP_DEFAULT_RETRIEVAL_PROFILE=openai-api
RAG_MVP_BGE_PROFILE_ENABLED=true
RAG_MVP_BGE_DATA_ROOT=data/profiles/bge-local
RAG_MVP_BGE_EMBEDDING_MODEL=BAAI/bge-m3
RAG_MVP_BGE_EMBEDDING_DIMENSION=1024
RAG_MVP_BGE_RERANKING_MODEL=BAAI/bge-reranker-v2-m3
RAG_MVP_BGE_DEVICE=auto
RAG_MVP_BGE_USE_FP16=false
RAG_MVP_BGE_EMBEDDING_BATCH_SIZE=8
RAG_MVP_BGE_RERANKING_BATCH_SIZE=8
RAG_MVP_BGE_EMBEDDING_MAX_LENGTH=8192
RAG_MVP_BGE_RERANKING_MAX_LENGTH=1024
RAG_MVP_BGE_MODEL_CACHE_DIR=.cache/huggingface
RAG_MVP_BGE_PROVIDER_TIMEOUT_SECONDS=60
RAG_MVP_BGE_QA_DEADLINE_SECONDS=45
RAG_MVP_BGE_QA_RETRIEVAL_BUDGET_SECONDS=20
RAG_MVP_BGE_RERANK_DEADLINE_SECONDS=10
RAG_MVP_BGE_QA_EVIDENCE_ASSESSMENT_BUDGET_SECONDS=10
# Stage ceilings are externally configurable while the total request deadline
# remains fail-closed. Acceptance runs must publish their exact values.
RAG_MVP_QA_DEADLINE_SECONDS=9.5
RAG_MVP_QA_RETRIEVAL_BUDGET_SECONDS=5.0
RAG_MVP_QA_EMBEDDING_BUDGET_SECONDS=4.5
RAG_MVP_QA_EVIDENCE_ASSESSMENT_BUDGET_SECONDS=5.0
RAG_MVP_QA_GENERATION_BUDGET_SECONDS=5.0
RAG_MVP_QA_FINALIZATION_BUDGET_SECONDS=0.1

# Never put a credential value in this file. Point Compose at an absolute host
# path outside the repository, or leave this unset to start safely but unready.
# RAG_MVP_OPENAI_API_KEY_SECRET_FILE=C:/absolute/path/outside/repo/openai_api_key

RAG_MVP_OCR_ENABLED=true
RAG_MVP_OCR_LANGUAGES=chi_sim+eng
RAG_MVP_LOG_LEVEL=INFO
# Use console for privacy-safe local JSON span evidence. For otlp, also set an
# explicit HTTP(S) /v1/traces endpoint; missing configuration keeps readiness false.
RAG_MVP_TELEMETRY_EXPORTER=none
# RAG_MVP_TELEMETRY_OTLP_TRACES_ENDPOINT=http://collector:4318/v1/traces
RAG_MVP_TELEMETRY_EXPORT_TIMEOUT_SECONDS=5
RAG_MVP_PRICING_VERSION=unconfigured
# Server drain + application cleanup must remain below the pinned 20-second
# Compose stop grace period.
RAG_MVP_SERVER_SHUTDOWN_GRACE_SECONDS=4
RAG_MVP_SHUTDOWN_GRACE_SECONDS=15
